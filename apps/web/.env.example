# SparkPoint web app — copy to .env.local and fill in. (Web-facing vars only;
# agent-service / contract secrets live with those services, not the web app.)

# WalletConnect — optional in dev; when set, enables the WalletConnect connector.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Base RPC endpoints (Alchemy). Optional in dev — wagmi falls back to public RPC.
NEXT_PUBLIC_BASE_RPC_URL=
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=
