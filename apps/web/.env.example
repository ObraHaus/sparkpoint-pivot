# SparkPoint web app — copy to .env.local and fill in. (Web-facing vars only;
# agent-service / contract secrets live with those services, not the web app.)

# WalletConnect — reserved for the upcoming wallet-auth feature. The WalletConnect
# connector is NOT wired in this UI build (only the injected/browser-wallet connector is).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Base RPC endpoints (Alchemy). Optional in dev — wagmi falls back to public RPC.
NEXT_PUBLIC_BASE_RPC_URL=
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=

# Agent BFF (same-origin proxy at /api/agent). SERVER-ONLY — never NEXT_PUBLIC, so
# neither value reaches the browser bundle. The route handler reads these to forward
# the browser's /api/agent/* calls to the internal agent with an injected bearer.
#   AGENT_INTERNAL_URL — internal base URL of the agent service. UNSET ⇒ the BFF
#     returns a clean 503 and the UI shows "assistant offline".
#   AGENT_S2S_TOKEN    — service-to-service bearer added server-side (a secret).
AGENT_INTERNAL_URL=
AGENT_S2S_TOKEN=

# (Removed: NEXT_PUBLIC_AGENT_BASE_URL — the browser ALWAYS goes through the same-origin BFF above;
# there is no client-side direct-to-agent override, so the agent URL never reaches the bundle.)

# SIWE session signing secret (Phase B). SERVER-ONLY — signs/verifies the httpOnly session
# cookie minted after a wallet proves control via Sign-In-With-Ethereum. FAIL-CLOSED: if unset,
# NO session can be minted or verified, so the (app) shell + /admin are unreachable (only the
# public landing / connect / verify / exit / trust remain). Set to a long random string
# (e.g. `openssl rand -hex 32`); rotating it invalidates all existing sessions. Must be present
# in BOTH the build AND runtime env (the middleware verifies sessions at the edge).
SESSION_SECRET=

# Beta whitelist (T047) — DEPOSIT-ONLY gate; NEVER gates withdraw / /exit / /trust.
# Optional csv of addresses allowed to make NEW deposits. Leave EMPTY for the testnet
# MVP: the gate is default-permissive on Base Sepolia (84532) and whenever no allowlist
# is configured, so deposits flow freely. Set it to restrict mainnet deposits to listed
# wallets. TODO(W6): superseded by a backend /beta-status endpoint (address → status).
NEXT_PUBLIC_BETA_ALLOWLIST=

# Construction gate (feature 003-landing-only-gate). FAIL-CLOSED: any value
# other than "false" locks the site to the landing page only; everything else
# redirects to /coming-soon. Set in each deployment's BUILD env (Coolify):
#   local dev / develop -> false  (full app)        public/main -> true (landing only)
# Launch = set both to false and redeploy. SITE_LOCKED is the real gate;
# NEXT_PUBLIC_SITE_LOCKED only keeps the landing's CTA from dead-ending.
SITE_LOCKED=false
NEXT_PUBLIC_SITE_LOCKED=false

# PUBLIC BETA (2026-10-04) — the access-gate switch. FAIL-CLOSED: exact "true" admits EVERY wallet
# that completes SIWE to the (app) shell; unset/anything else keeps the beta allowlist gate in
# force. Admin is never widened (it stays the DB allowlist's job). Must be present in BOTH the
# build AND runtime env (the edge middleware reads it); set it, then redeploy. Open at launch:
BETA_OPEN=true

# Public site URL — used for metadataBase so OG/canonical URLs resolve absolute.
# Set per deployment to the real domain; falls back to https://sparkpoint.io.
NEXT_PUBLIC_SITE_URL=

# Newsletter — Mailjet PUBLIC subscription-widget endpoint (NOT a secret; the
# /api/subscribe route proxies the email to it). Override only if the list /
# widget changes; defaults to the committed value in the route.
MAILJET_WIDGET_SUBSCRIBE_URL=https://14ij2.mjt.lu/wgt/14ij2/0r1n/subscribe?c=22cd210c

# ── Feature 006: force-refresh on new release ───────────────────────────────
# Per-build release id. Normally UNSET locally (next.config.ts derives it from SOURCE_COMMIT +
# a build timestamp). On Coolify, expose the commit via the build_command (git rev-parse) or the
# "Include Source Commit in Build" toggle; the timestamp fallback means the refresh arms regardless.
# NEXT_PUBLIC_BUILD_ID is produced by the build — do not set it by hand.
# Auto-reload kill-switch. Ships OFF; set to "true" only after the US2 safety nets are verified.
NEXT_PUBLIC_FORCE_REFRESH=false

# --- 076: NEAR-only login ---
NEAR_RPC_URL=
NEAR_LOGIN_RECIPIENT=
# TEST-ONLY (never production): skips only the on-chain key lookup, pinned to one test account.
NEAR_LOGIN_TEST_MODE=
NEAR_LOGIN_TEST_ACCOUNT=
