pragma solidity 0.8.24;

import { Test } from "forge-std/Test.sol";
import { stdJson } from "forge-std/StdJson.sol";
import { BrokerRevenueDistributor } from "../../src/broker/BrokerRevenueDistributor.sol";
import { MockERC20 } from "../mocks/Mocks.sol";

/// @title Cross-language parity: proofs built in Python must verify in this contract.
///
/// @notice The off-chain builder (`services/agent/.../broker_allocation.py`) computes the split and
///         commits a Merkle root; this contract verifies claims against it. Those are two different
///         languages implementing one encoding, and if they ever disagree the symptom is not a
///         failing build — it is a holder whose claim reverts with `BadProof` against an
///         **immutable, already-published** period that cannot be corrected.
///
/// @dev The classic footgun is `abi.encode` vs `abi.encodePacked`; the subtler ones are pair-sort
///      order and how an odd node is promoted. This test catches all of them the only way that
///      really counts: by replaying a real generated allocation and claiming every leaf on an EVM.
///
///      The fixture is written by `test_writes_the_parity_fixture_the_solidity_test_replays`.
///      ⚠️ If it is missing, this test SKIPS rather than silently passing — a parity test that
///      quietly does nothing is worse than no parity test.
contract AllocationParityTest is Test {
    using stdJson for string;

    BrokerRevenueDistributor internal dist;
    MockERC20 internal token;

    string internal fixtureJson;
    bool internal haveFixture;

    function setUp() public {
        string memory path = string.concat(vm.projectRoot(), "/test/fixtures/allocation-parity.json");
        try vm.readFile(path) returns (string memory data) {
            fixtureJson = data;
            haveFixture = bytes(data).length > 0;
        } catch {
            haveFixture = false;
        }

        token = new MockERC20("USD Coin", "USDC", 6);
        dist = new BrokerRevenueDistributor(address(this));
    }

    function test_ThePythonBuiltRootAcceptsEveryPythonBuiltProof() public {
        if (!haveFixture) {
            emit log("SKIP: fixture missing - run the agent's test_broker_allocation.py first");
            return;
        }

        uint256 periodId = fixtureJson.readUint(".periodId");
        uint256 pot = vm.parseUint(fixtureJson.readString(".pot"));
        bytes32 root = fixtureJson.readBytes32(".merkleRoot");
        uint256 totalAllocated = vm.parseUint(fixtureJson.readString(".totalAllocated"));

        token.mint(address(this), pot);
        token.approve(address(dist), pot);
        uint256 opened = dist.fundPeriod(address(token), pot);
        assertEq(opened, periodId, "fixture period id must line up with a fresh distributor");

        dist.publishAllocations(periodId, root, totalAllocated);

        uint256 count = fixtureJson.readUint(".allocationCount");
        assertGt(count, 0, "a fixture with no allocations would prove nothing");
        uint256 paid;

        for (uint256 i; i < count; ++i) {
            string memory base = string.concat(".allocations[", vm.toString(i), "]");
            address account = fixtureJson.readAddress(string.concat(base, ".account"));
            uint256 amount = vm.parseUint(fixtureJson.readString(string.concat(base, ".amount")));
            bytes32[] memory proof = fixtureJson.readBytes32Array(string.concat(base, ".proof"));

            // The whole point: a proof generated by the other language, verified by this contract.
            vm.prank(account);
            dist.claim(periodId, amount, proof);

            assertEq(token.balanceOf(account), amount, "claimant received their exact amount");
            paid += amount;
        }

        assertEq(paid, totalAllocated, "every published allocation was claimable");
        assertEq(dist.owed(address(token)), 0, "nothing is still owed once all claims settle");
        // Dust stays put. It is not stranded and it is not sweepable - it raises `available()`.
        assertEq(dist.available(address(token)), pot - totalAllocated, "dust rolls to the next period");
    }

    function test_ATamperedAmountFailsEvenWithAValidProof() public {
        if (!haveFixture) {
            emit log("SKIP: fixture missing");
            return;
        }

        uint256 periodId = fixtureJson.readUint(".periodId");
        uint256 pot = vm.parseUint(fixtureJson.readString(".pot"));
        bytes32 root = fixtureJson.readBytes32(".merkleRoot");
        uint256 totalAllocated = vm.parseUint(fixtureJson.readString(".totalAllocated"));

        token.mint(address(this), pot);
        token.approve(address(dist), pot);
        dist.fundPeriod(address(token), pot);
        dist.publishAllocations(periodId, root, totalAllocated);

        address account = fixtureJson.readAddress(".allocations[0].account");
        uint256 amount = vm.parseUint(fixtureJson.readString(".allocations[0].amount"));
        bytes32[] memory proof = fixtureJson.readBytes32Array(".allocations[0].proof");

        // Asking for one unit more than the leaf commits to. The proof is genuine; the amount is not.
        vm.prank(account);
        vm.expectRevert(BrokerRevenueDistributor.BadProof.selector);
        dist.claim(periodId, amount + 1, proof);
    }

    function test_AnotherAccountCannotReplaySomeoneElsesProof() public {
        if (!haveFixture) {
            emit log("SKIP: fixture missing");
            return;
        }

        uint256 periodId = fixtureJson.readUint(".periodId");
        uint256 pot = vm.parseUint(fixtureJson.readString(".pot"));
        bytes32 root = fixtureJson.readBytes32(".merkleRoot");
        uint256 totalAllocated = vm.parseUint(fixtureJson.readString(".totalAllocated"));

        token.mint(address(this), pot);
        token.approve(address(dist), pot);
        dist.fundPeriod(address(token), pot);
        dist.publishAllocations(periodId, root, totalAllocated);

        uint256 amount = vm.parseUint(fixtureJson.readString(".allocations[0].amount"));
        bytes32[] memory proof = fixtureJson.readBytes32Array(".allocations[0].proof");

        // The leaf binds the account, so a stolen proof proves nothing for a different caller.
        vm.prank(address(0xBADBAD));
        vm.expectRevert(BrokerRevenueDistributor.BadProof.selector);
        dist.claim(periodId, amount, proof);
    }

    /// @notice The leaf encoding itself, asserted directly against a value Python produced.
    /// @dev `keccak256(abi.encode(...))` — NOT `encodePacked`. Pinned so a change to either side
    ///      that "looks equivalent" fails here rather than in production.
    function test_LeafEncodingMatchesTheOffChainBuilder() public view {
        assertEq(
            dist.leafFor(1, 0x1111111111111111111111111111111111111111, 5),
            bytes32(0xe8a9097b3b262b5018db640bc361ba39ee641a21bdc085f5d2e6dae071122386),
            "leafFor must equal keccak(abi.encode(uint256,address,uint256)) as built off-chain"
        );
    }
}
