{
  "name": "sparkpoint-pivot",
  "private": true,
  "version": "0.0.0",
  "description": "SparkPoint Pivot — non-custodial AI DeFi assistant + Aave yield vault on Base (monorepo root).",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev": "turbo run dev",
    "preflight": "bash scripts/preflight.sh"
  },
  "pnpm": {
    "overrides": {
      "ws": ">=8.21.0",
      "postcss": ">=8.5.10",
      "sharp": ">=0.35.3"
    },
    "onlyBuiltDependencies": [
      "sharp",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "turbo": "^2.3.3"
  }
}
