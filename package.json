{
  "name": "sparkpoint-pivot",
  "private": true,
  "version": "0.0.0",
  "description": "SparkPoint Pivot — non-custodial AI DeFi assistant + Aave yield vault on Base (monorepo root).",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev": "turbo run dev",
    "preflight": "bash scripts/preflight.sh",
    "earn:sim:kamino": "node scripts/earn-sim/kamino-sim.mjs",
    "earn:sim:morpho": "node scripts/earn-sim/morpho-sim.mjs"
  },
  "pnpm": {
    "overrides": {
      "nanoid": "^3.3.17",
      "postcss": ">=8.5.23",
      "sharp": ">=0.35.5",
      "source-map-js": ">=1.2.2",
      "browserslist": ">=4.28.7",
      "baseline-browser-mapping": ">=2.11.0",
      "ws": ">=8.21.0",
      "zod@<4.6.6": ">=4.6.6 <5"
    },
    "onlyBuiltDependencies": [
      "sharp",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "turbo": "^2.3.3"
  }
}
