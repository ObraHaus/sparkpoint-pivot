# SparkPoint Phase 2 — environment template (T008). NO REAL SECRETS COMMITTED.
# Real values live in /home/hello/project/.claude/.env (chmod 600, gitignored).

# --- AI (Hermes) ---
# Phase-2 stopgap: Claude Code OAuth (Authorization: Bearer + anthropic-beta:
# oauth-2025-04-20 + the Claude-Code system prefix). Phase-3/prod: org key.
ANTHROPIC_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=          # Phase-3/prod on client infra

# --- RPC + simulation (no Tenderly — self-hosted Anvil fork) ---
ALCHEMY_ACCESS_KEY=
BASE_SEPOLIA_RPC_URL=         # https://base-sepolia.g.alchemy.com/v2/<key>
BASE_MAINNET_ARCHIVE_RPC_URL= # archive-grade; doubles as `anvil --fork-url`
SIM_FORK_RPC_URL=http://<spark-anvil-host>:8545   # spark-anvil (the Simulator)

# --- 017: live Aave v3 USDC supply-APY read (PUBLIC, non-key, view-only). Agent env. ---
# Unset ⇒ the recommender's APY stays null (honest); set on the alpha agent to enable the live rate.
AAVE_POOL_ADDRESS=            # Base Sepolia 0x8bAB6d1b75f19e9eD9fCe8b9BD338844fF79aE27
AAVE_RESERVE_USDC_ADDRESS=    # Base Sepolia 0xba50933C268F567BDC86E1aC131BE072C6B0b71A

# --- wallet / bundler ---
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=   # Reown project id
BUNDLER_URL=                 # Alchemy AA bundler v0.7 (Pimlico fallback)

# --- data / indexers ---
DUNE_API_KEY=

# --- contracts / deploy (Base Sepolia 84532) ---
DEPLOYER_ADDRESS=
DEPLOYER_PRIVATE_KEY=        # NEVER commit; testnet only
TEST_USER_ADDRESS=
BASESCAN_ETHERSCAN_API_KEY=  # Sepolia verify (mainnet is paid — Phase 3)

# --- database ---
DATABASE_URL=postgresql://<user>@<db-host>:5432/sparkpoint   # spark-postgres + pgvector

# --- access control (Phase B: SIWE + beta/admin allowlist) ---
# Bootstrap allowlists — comma-separated wallet addresses (case-insensitive; checksum-normalized).
# Set on the AGENT service: the agent seeds the DB-backed allowlist from these on boot (idempotent),
# after which wallets are managed via the admin panel (audit-logged). ACCESS gate only — these
# NEVER gate /exit, /trust, or withdraw (N2).
#   BETA_ALLOWLIST  — wallets allowed into the (app) shell.
#   ADMIN_ALLOWLIST — wallets allowed into /admin + admin APIs (admin implies beta).
BETA_ALLOWLIST=
ADMIN_ALLOWLIST=
# PUBLIC BETA (2026-10-04, WEB app): exact "true" admits EVERY wallet that completes SIWE to the
# (app) shell — no allowlist/application/SRK gate. FAIL-CLOSED: unset/anything else keeps the
# allowlist. Never grants admin. Build + runtime env; set then redeploy. NEVER gates /exit,
# /trust, or withdraw (N2).
BETA_OPEN=

# --- 026: the 1M-SRK Ethereum-MAINNET auto-gate (agent env; ALL THREE optional) ---
# A wallet holding >= SRK_GATE_MIN_BALANCE of the mainnet SRK token is auto-added to the beta
# allowlist at SIWE login (audit-logged with actor 'srk-gate') instead of being sent to the access
# application form. This is the ONLY place chain 1 is touched: a single keyless `eth_call` of
# `balanceOf`. Mainnet is deliberately NOT registered in API_SUPPORTED_CHAIN_IDS, the wagmi
# registries or packages/shared chain metadata — the app itself stays testnet-only.
# UNSET (either of the first two) => the gate is SILENTLY SKIPPED and every non-allowlisted wallet
# simply sees the application form. It is fail-open at every step and can never block a login.
ETH_MAINNET_RPC_URL=          # any Ethereum-mainnet JSON-RPC (read-only; no key is ever used)
SRK_MAINNET_ADDRESS=          # 0x0488401c3f535193fa8df029d9ffe615a06e74e6 (SRK, 18 dp)
SRK_GATE_MIN_BALANCE=         # BASE UNITS, default 1000000000000000000000000 (= 1,000,000 SRK)

# --- 012/026: SRK Premium price (agent env) ---
# BASE UNITS (compared straight against the ERC-20 Transfer value) — NOT whole tokens. The
# client-decided price is 10,000 SRK/month, so this is 10000e18. A bare `10000` would be 1e-14 SRK
# and would accept dust as a full month. Unset => the code default (10000e18) applies.
# It MUST match apps/web `PREMIUM_PRICE_SRK_WHOLE` — web and agent flip together or purchases break.
PREMIUM_PRICE_SRK=10000000000000000000000
# NOTE: the WEB app additionally needs SESSION_SECRET (signs the SIWE session cookie) — see
# apps/web/.env.example. The agent's LLM-gateway view reuses LITELLM_BASE_URL / LITELLM_API_KEY.

# --- policy / ops ---
POLICY_VERSION=policy@2026.06.0

# --- 028 Sparky memory v2 (activity fold) ---
# OPTIONAL: the SrkFaucet address (026) so faucet claims can fold into Sparky's memory.
# Unset simply disables that memory source; everything else works. Base Sepolia only.
SRK_FAUCET_ADDRESS=           # 0x93766a1C6c2076F658710770549af34Ac46dB2a9 on develop/alpha

# --- 068: cross-chain swaps via NEAR Intents 1Click (agent env; all OPTIONAL) ---
# The route table ships inside the agent package (crosschain/routes.json). CROSSCHAIN_ROUTES_PATH
# overrides it for a client-specific table; CROSSCHAIN_ENABLED=0 turns the chat/API feature off
# (default: the JSON feature_enabled value, true). Neither can move funds: the user sends the
# origin transaction from their own wallet.
CROSSCHAIN_ROUTES_PATH=
CROSSCHAIN_ENABLED=
# OPTIONAL 1Click API key. Unset => keyless quotes (1Click adds its 0.25% routing fee, surfaced in
# the preview as a fee note). When set it is sent as a Bearer token and is NEVER logged or exposed.
ONECLICK_API_KEY=

# --- 076: NEAR-only login (web server env) ---
# Read-only NEAR RPC used for `view_access_key` during NEP-413 login. Falls back to
# NEXT_PUBLIC_NEAR_RPC_URL, then the mainnet/testnet default. No transaction is ever sent.
NEAR_RPC_URL=
# App domain bound into the signed NEP-413 message. Set to the deployed host (e.g.
# beta.sparkpoint.io). Unset falls back to SIWE_DOMAIN, then the request host.
NEAR_LOGIN_RECIPIENT=
# TEST-ONLY: skips only the on-chain full-access key lookup; the ed25519 signature is still
# verified. Pin it to one throwaway account. NEVER set in production.
NEAR_LOGIN_TEST_MODE=
NEAR_LOGIN_TEST_ACCOUNT=

# --- 078: Rhea same-chain NEAR supply/withdraw (BOTH default OFF) ---
# Server gate for /api/earn/rhea/live (unsigned preflight) and /api/earn/rhea/receipt, plus the
# /vault/live server page. Any value other than "true" means off (404). Read-only + user-signed.
EARN_LIVE_RHEA=
# Browser gate for the /vault and Sparky Rhea entry points. Must also be "true" to show them.
NEXT_PUBLIC_EARN_LIVE_RHEA=
