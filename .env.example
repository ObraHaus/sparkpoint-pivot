# SparkPoint Phase 2 — environment template (T008). NO REAL SECRETS COMMITTED.
# Real values live in /home/hello/project/.claude/.env (chmod 600, gitignored).

# --- AI (Hermes) ---
# Phase-2 stopgap: Claude Code OAuth (Authorization: Bearer + anthropic-beta:
# oauth-2025-04-20 + the Claude-Code system prefix). Phase-3/prod: org key.
ANTHROPIC_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=          # Phase-3/prod on client infra

# --- RPC + simulation (no Tenderly — self-hosted Anvil fork) ---
ALCHEMY_ACCESS_KEY=
BASE_SEPOLIA_RPC_URL=         # https://base-sepolia.g.alchemy.com/v2/<key>
BASE_MAINNET_ARCHIVE_RPC_URL= # archive-grade; doubles as `anvil --fork-url`
SIM_FORK_RPC_URL=http://192.168.31.228:8545   # spark-anvil (the Simulator)

# --- wallet / bundler ---
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=   # Reown project id
BUNDLER_URL=                 # Alchemy AA bundler v0.7 (Pimlico fallback)

# --- data / indexers ---
DUNE_API_KEY=

# --- contracts / deploy (Base Sepolia 84532) ---
DEPLOYER_ADDRESS=
DEPLOYER_PRIVATE_KEY=        # NEVER commit; testnet only
TEST_USER_ADDRESS=
BASESCAN_ETHERSCAN_API_KEY=  # Sepolia verify (mainnet is paid — Phase 3)

# --- database ---
DATABASE_URL=postgresql://sparkpoint@192.168.31.26:5432/sparkpoint   # spark-postgres + pgvector

# --- access control (Phase B: SIWE + beta/admin allowlist) ---
# Bootstrap allowlists — comma-separated wallet addresses (case-insensitive; checksum-normalized).
# Set on the AGENT service: the agent seeds the DB-backed allowlist from these on boot (idempotent),
# after which wallets are managed via the admin panel (audit-logged). ACCESS gate only — these
# NEVER gate /exit, /trust, or withdraw (N2).
#   BETA_ALLOWLIST  — wallets allowed into the (app) shell.
#   ADMIN_ALLOWLIST — wallets allowed into /admin + admin APIs (admin implies beta).
BETA_ALLOWLIST=
ADMIN_ALLOWLIST=
# NOTE: the WEB app additionally needs SESSION_SECRET (signs the SIWE session cookie) — see
# apps/web/.env.example. The agent's LLM-gateway view reuses LITELLM_BASE_URL / LITELLM_API_KEY.

# --- policy / ops ---
POLICY_VERSION=policy@2026.06.0
