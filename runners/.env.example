# Copy to .env. This file never holds a key — the two below are read from your secret store.

# ⚠️ Which runner this process IS, when running from the container image: "keeper" or "sweeper".
# It selects both the entrypoint and which heartbeat the container healthcheck reads, so the two
# Coolify apps are the same image with SERVICE set differently. Running the scripts directly
# (pnpm keeper / pnpm sweeper) does not need it — the script name already says which one.
SERVICE=keeper

# Which chain, and how to reach it. Both are checked twice: against the address book, and against
# what the node actually answers. Use the ARCHIVE RPC (the public node prunes state).
DEPLOY_ENV=mainnet
CHAIN_ID=4663
RPC_URL=

# Where the address book is. Default: <cwd>/contracts/deployments/<chainId>/addresses.json, which in
# the container is /app/contracts/... where nothing is mounted — so set this to the ABSOLUTE path of
# the mounted book, or supply the book as base64 (below).
# DEPLOYMENT_PATH=/srv/sparky-beta/addresses.json

# ⚠️ No file mount available (this Coolify version has no storage API)? Supply the book as base64 —
# the container entrypoint decodes it to DEPLOYMENT_PATH at start-up.
# DEPLOYMENT_JSON_B64=<base64 of contracts/deployments/4663/addresses.json>

# ⚠️ Hot keys. Neither holds any privilege — every call these runners make is permissionless — but
# both spend gas, so treat them as funded wallets. Beta-only keys; never reuse for alpha/testnet.
KEEPER_PRIVATE_KEY=
SWEEPER_PRIVATE_KEY=

# ⚠️⚠️ Below this balance the runner warns every tick and keeps running. Nothing can top it up on a
# real chain, and an unfunded runner is indistinguishable from one with nothing to do — exactly how
# a stall hides. Wire alerting to the warning, not to the process being up.
# 0.001 ETH (W.9 follow-up, 2026-09-16) — the warn-only floor the beta bots ship with.
KEEPER_GAS_FLOOR_WEI=1000000000000000
SWEEPER_GAS_FLOOR_WEI=1000000000000000

# How often each wakes. The round is 86,400s (DAILY since the 2026-09-16 setRoundSeconds upgrade), so
# a 60s keeper tick settles within a minute of the daily boundary; there is no benefit to going
# lower and it only costs gas on the reads.
KEEPER_TICK_SEC=60
SWEEP_INTERVAL_SEC=300

# The id space to scan for clocked-in brokers (the beta supply is 5,555; the engine has no
# MAX_SUPPLY constant by design).
SCAN_MAX_ID=5555

# The Pons bonding curve. Defaults to the book's `beta.ponsCurve`; override for a fresh launch.
# CURVE_ADDRESS=0xbE38eE16810d2ac0a9AA944fdDd68b07a5E17C53

# ⚠️ Post-graduation is deferred: when the token graduates, set these and extend the sweeper with
# the `sweepPool` call (the ABI is already in shared/abis.ts). Until then the hook sweep is Pons'
# keeper's, and nothing is lost — fees are credited and wait.
# PONS_HOOK=
# POOL_ID=

# ⚠️ The container healthcheck marks the runner unhealthy once its heartbeat is older than this.
# An idle tick still beats, so a working runner refreshes it every interval; the default is
# (interval × 3 + 60)s. Override only if your cadence differs.
# HEALTHCHECK_MAX_AGE_SEC=240

# Where the liveness heartbeats are written. Point your healthcheck at the file age.
HEARTBEAT_DIR=/tmp/sparky-beta-runners
